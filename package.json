{
  "name": "@wayne/dsh-finance",
  "version": "1.9.0",
  "private": false,
  "description": "家庭保单管家 + 记账：上传合同识别保单档案、看懂保障、缴费与到期提醒可完成；账单导入自动分类合并。数据只存本机。",
  "license": "MIT",
  "author": {
    "name": "WayneZhon"
  },
  "homepage": "https://github.com/WayneZhon/dsh-finance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayneZhon/dsh-finance.git"
  },
  "bugs": {
    "url": "https://github.com/WayneZhon/dsh-finance/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "!lib/*.test.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs",
    "!docs/images",
    "market"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "personal-finance",
    "budget",
    "expense-tracker",
    "bill-import",
    "alipay",
    "wechat-pay",
    "个人理财",
    "记账",
    "账单导入",
    "预算",
    "净资产"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check index.js && node scripts/build.mjs --check",
    "test": "node --test lib/ scripts/test-integration.mjs && node scripts/test.mjs",
    "demo": "node scripts/make-demo.mjs",
    "prepublishOnly": "node scripts/prepublish.mjs && npm test && npm run market",
    "pack:check": "npm pack --dry-run",
    "market": "node scripts/build-market-index.mjs",
    "market:check": "node scripts/build-market-index.mjs --check"
  },
  "engines": {
    "node": ">=20"
  }
}
